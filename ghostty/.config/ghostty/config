# Ghostty configuration
# JetBrains IDE New Dark theme

# =============================================================================
# Font Configuration
# =============================================================================
font-family = "JetBrainsMono Nerd Font"
font-size = 14

# =============================================================================
# Color Scheme (Kanagawa Dragon)
# =============================================================================
background = #181616

foreground = #c5c9c5
selection-background = #2D4F67
selection-foreground = #c5c9c5

cursor-color = #C8C093
cursor-style = block
cursor-text = #181616

# ANSI Colors (kanagawa-dragon)
palette = 0=#0d0c0c
palette = 1=#c4746e
palette = 2=#8a9a7b
palette = 3=#c4b28a
palette = 4=#8ba4b0
palette = 5=#8992a7
palette = 6=#8ea4a2
palette = 7=#c5c9c5

palette = 8=#625e5a
palette = 9=#e46876
palette = 10=#87a987
palette = 11=#e6c384
palette = 12=#7E9CD8
palette = 13=#957FB8
palette = 14=#7AA89F
palette = 15=#DCD7BA

